#!/usr/bin/env bash
# pre-push git hook — coverage gate
#
# Blocks the push if test coverage is below 80%.
# Install with:   bash scripts/install_hooks.sh
# Or manually:    git config core.hooksPath .githooks

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "=================================================="
echo "  Pre-push coverage gate"
echo "=================================================="

cd "$SCRIPT_DIR"

python scripts/check_coverage.py
exit $?
